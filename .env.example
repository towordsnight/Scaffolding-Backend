# Postgres (Supabase connection string)
DATABASE_URL=

# Redis (Supabase Redis or local)
REDIS_URL=

# JWT — use a long random secret in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Anthropic (AI tutor)
ANTHROPIC_API_KEY=
ANTHROPIC_HINT_MODEL=claude-haiku-4-5

# Figma (MCP — Personal Access Token from figma.com → Settings → Security)
FIGMA_API_KEY=
